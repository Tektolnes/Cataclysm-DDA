[
  {
    "type": "effect_on_condition",
    "id": "EOC_DIMENSION_TELE_SICKNESS",
    "effect": [
      { "math": [ "_tele_resonance_dur = time(' 1 hour')" ] },
      { "if": { "u_has_worn_with_flag": "PORTAL_PROOF" }, "then": { "math": [ "_tele_resonance_dur *= 0.5" ] } },
      { "if": { "u_has_worn_with_flag": "PSYSHIELD_PARTIAL" }, "then": { "math": [ "_tele_resonance_dur *= 0.5" ] } },
      {
        "if": { "u_has_trait": "INTERSTICE_RESONANCE_3" },
        "then": { "math": [ "_tele_resonance_dur *= 0.5" ] },
        "else": {
          "if": { "u_has_trait": "INTERSTICE_RESONANCE_2" },
          "then": { "math": [ "_tele_resonance_dur *= 0.25" ] },
          "else": { "if": { "u_has_trait": "INTERSTICE_RESONANCE" }, "then": { "math": [ "_tele_resonance_dur *= 0.5" ] } }
        }
      },
      { "if": { "u_has_trait": "anti_shape" }, "then": { "math": [ "_tele_resonance_dur *= 0.5" ] } },
      { "u_add_effect": "effect_dimension_tele_resonance", "duration": { "context_val": "tele_resonance_dur" } },
      { "if": { "not": { "u_has_trait": "anti_shape" } }, "then": { "u_add_effect": "nausea", "duration": 60 } }
    ]
  }
]
